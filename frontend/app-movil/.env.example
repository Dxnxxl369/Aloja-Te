# Copia este archivo a .env y ajusta lo que necesites. Expo solo lee variables EXPO_PUBLIC_*.

# Gateway. 10.0.2.2 = localhost de tu PC visto desde el emulador de Android.
# En un celular físico usa la IP de tu PC en la red local, ej. http://192.168.1.20:8080
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080

# Solo demo: muestra el botón "Simular pago del banco" en la pantalla de pago.
EXPO_PUBLIC_PAGO_SIMULADO=1

# IA local (Qwen3.5-0.8B con llama.rn). Requiere development build; en Expo Go queda inactiva.
EXPO_PUBLIC_IA_LOCAL=true

# Agente con IA de la nube (Groq). Con clave, la app llama a Groq directo; sin clave, a través de MS-04.
# OJO: va DENTRO de la app instalada (cualquiera con el APK puede sacarla): solo demos, rótala al terminar.
EXPO_PUBLIC_GROQ_API_KEY=
