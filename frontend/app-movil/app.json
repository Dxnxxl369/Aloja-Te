{
  "expo": {
    "name": "Aloja-Te",
    "slug": "alojate-movil",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.alojate.movil",
      "googleServicesFile": "./google-services.json",
      "usesCleartextTraffic": true,
      "buildArchs": [
        "arm64-v8a"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#2563eb"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2563eb"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2563eb"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "076d13ac-b356-4d67-9d6b-ae8d61db1a1c"
      }
    },
    "owner": "danielqc"
  }
}
