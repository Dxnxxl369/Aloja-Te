{
    "name": "alojate/ms-comercial-financiero",
    "type": "project",
    "description": "MS-03: Microservicio Comercial y Financiero (Aloja-Te) con Laravel y DDD",
    "keywords": ["laravel", "microservice", "ddd", "alojate"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^10.0 || ^11.0",
        "doctrine/dbal": "^3.8",
        "php-amqplib/php-amqplib": "^3.6"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^7.0 || ^8.0",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "audit": {
            "block": false
        },
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
