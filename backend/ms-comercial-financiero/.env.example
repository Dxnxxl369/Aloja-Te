# Copiar a .env y completar con tus valores locales (el .env no se versiona).
APP_NAME=AlojaTe-Comercial
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:3003

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=alojate_finanzas
DB_USERNAME=postgres
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
