# Copiar a .env y completar con tus valores locales (el .env no se versiona).
PORT=3002

# DynamoDB Local (credenciales ficticias de desarrollo).
# Si no hay DynamoDB en el puerto 8000, el servicio usa memoria RAM.
DYNAMODB_TABLE_NAME=AlojaTe_Reservas
DYNAMODB_ENDPOINT=http://localhost:8000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# Opcional (por defecto amqp://guest:guest@localhost:5672)
# RABBITMQ_URL=amqp://guest:guest@localhost:5672
