# ==============================================================================
# ALOJA-TE: MS-02 RESERVAS Y ESTADÍAS (NestJS / Microsoft Azure VM)
# ==============================================================================
PORT=3002

# Configuración DynamoDB Local en Azure con Docker:
# Para levantar el contenedor de DynamoDB Local con persistencia en Azure:
# docker run -d --name dynamodb-local -p 8000:8000 -v /data/dynamodb:/home/dynamodblocal/data amazon/dynamodb-local -jar DynamoDBLocal.jar -sharedDb -dbPath /home/dynamodblocal/data
#
# Si no levantas DynamoDB Local, el microservicio activa automáticamente su motor en memoria RAM persistente.
DYNAMODB_TABLE_NAME=AlojaTe_Reservas
DYNAMODB_ENDPOINT=http://localhost:8000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
