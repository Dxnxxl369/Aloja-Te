PORT=3002
# Configuración para DynamoDB Local (sin cuenta de AWS, credenciales ficticias de desarrollo local)
# Si no tienes DynamoDB Local ejecutándose en el puerto 8000, el servicio activa su fallback en memoria RAM automáticamente
DYNAMODB_TABLE_NAME=AlojaTe_Reservas
DYNAMODB_ENDPOINT=http://localhost:8000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
