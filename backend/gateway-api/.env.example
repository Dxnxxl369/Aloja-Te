# ==============================================================================
# ALOJA-TE: API GATEWAY (AWS EC2)
# ==============================================================================
# Puerto del API Gateway público expuesto en AWS
PORT=8080

# Enrutamiento hacia Microservicios:
# MS-01: Usuarios y Alojamientos (en la misma instancia de AWS o IP interna)
MS_USUARIOS_URL=http://localhost:3001

# MS-02: Reservas y Estadías (Desplegado en Microsoft Azure VM)
# Reemplazar con la IP pública de Azure del Compañero 2:
MS_RESERVAS_URL=http://IP_PUBLICA_AZURE:3002

# MS-03: Comercial y Financiero (Desplegado en Google Cloud GCP VM)
# Reemplazar con la IP pública de GCP del Compañero 3:
MS_COMERCIAL_URL=http://IP_PUBLICA_GCP:3003

# MS-04: IA Copiloto & Reportes Generativos (Groq + Gemini + Ollama)
MS_REPORTES_URL=http://localhost:3004

# Servicio de Correo Transaccional (Resend API)
RESEND_API_KEY=re_tu_resend_api_key_aqui
RESEND_FROM=Aloja-Te <onboarding@resend.dev>
